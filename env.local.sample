# =============================================================================
# 环境变量配置文件示例
# 复制此文件为 env.local 并填入实际的值
# =============================================================================

# Airflow 配置
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:YOUR_AIRFLOW_PASSWORD@postgres/airflow
AIRFLOW__CELERY__RESULT_BACKEND=db+postgresql://airflow:YOUR_AIRFLOW_PASSWORD@postgres/airflow
AIRFLOW__CELERY__BROKER_URL=redis://:@redis:6379/0
AIRFLOW__CORE__FERNET_KEY=YOUR_FERNET_KEY
AIRFLOW__API_AUTH__JWT_SECRET=YOUR_JWT_SECRET
AIRFLOW__WEBSERVER__SECRET_KEY=YOUR_WEBSERVER_SECRET

# Airflow 用户配置
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=YOUR_AIRFLOW_USER_PASSWORD

# MinIO 配置
MINIO_ROOT_USER=YOUR_MINIO_USER
MINIO_ROOT_PASSWORD=YOUR_MINIO_PASSWORD
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY
AWS_REGION=us-east-1

# PostgreSQL 配置
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD
POSTGRES_USER=YOUR_POSTGRES_USER
POSTGRES_DB=YOUR_POSTGRES_DB

# Superset 配置
SUPERSET_ADMIN_USERNAME=YOUR_SUPERSET_ADMIN_USER
SUPERSET_ADMIN_PASSWORD=YOUR_SUPERSET_ADMIN_PASSWORD
SUPERSET_ADMIN_EMAIL=YOUR_SUPERSET_ADMIN_EMAIL
SUPERSET_SECRET_KEY=YOUR_SUPERSET_SECRET_KEY

# Superset 数据库配置
SUPERSET_DATABASE_DB=YOUR_SUPERSET_DB
SUPERSET_DATABASE_PASSWORD=YOUR_SUPERSET_DB_PASSWORD
SUPERSET_DATABASE_USER=YOUR_SUPERSET_DB_USER
SUPERSET_DATABASE_URL=postgresql+psycopg2://YOUR_SUPERSET_DB_USER:YOUR_SUPERSET_DB_PASSWORD@postgres:5432/YOUR_SUPERSET_DB

# Airflow 数据库配置
AIRFLOW_DB_PASSWORD=YOUR_AIRFLOW_DB_PASSWORD

# MySQL 配置 (用于 DataHub)
MYSQL_ROOT_PASSWORD=YOUR_MYSQL_ROOT_PASSWORD
MYSQL_PASSWORD=YOUR_MYSQL_PASSWORD
EBEAN_DATASOURCE_PASSWORD=YOUR_EBEAN_DATASOURCE_PASSWORD

# DataHub 配置
DATAHUB_SYSTEM_CLIENT_SECRET=YOUR_DATAHUB_SYSTEM_CLIENT_SECRET
DATAHUB_SECRET=YOUR_DATAHUB_SECRET 