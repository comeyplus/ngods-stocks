# MinIO配置
MINIO_ENDPOINT_URL=http://minio:9000
MINIO_ACCESS_KEY_ID=${MINIO_ROOT_USER}
MINIO_SECRET_ACCESS_KEY=${MINIO_ROOT_PASSWORD}
MINIO_REGION_NAME=${AWS_REGION}

# Airflow 用户 ID（Linux/Mac 用户运行 `id -u` 获取）
AIRFLOW_UID=50000

# Airflow Docker 镜像
AIRFLOW_IMAGE_NAME=apache/airflow:3.0.3

# 可选：额外的 Python 包
# _PIP_ADDITIONAL_REQUIREMENTS=your-additional-packages 