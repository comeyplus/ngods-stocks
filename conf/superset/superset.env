# database configurations (do not modify)
DATABASE_DB=${SUPERSET_DATABASE_DB}
DATABASE_HOST=postgres
DATABASE_PASSWORD=${SUPERSET_DATABASE_PASSWORD}
DATABASE_USER=${SUPERSET_DATABASE_USER}
DATABASE_PORT=5432
DATABASE_DIALECT=postgresql

# database engine specific environment variables
# change the below if you prefers another database engine
DATABASE_URL=${SUPERSET_DATABASE_URL}
EXAMPLE_DB_URL=${SUPERSET_DATABASE_URL}

# Add the mapped in /app/pythonpath_docker which allows devs to override stuff
PYTHONPATH=/app/pythonpath:/app/pythonpath_docker
REDIS_HOST=redis
REDIS_PORT=6379

FLASK_ENV=production
SUPERSET_ENV=production
SUPERSET_LOAD_EXAMPLES=yes
SUPERSET_SECRET_KEY=${SUPERSET_SECRET_KEY}
CYPRESS_CONFIG=false
SUPERSET_PORT=8088 