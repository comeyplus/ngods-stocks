create or replace view airflow_bronze_airflow_bronze.in_yahoo_finance
  
  
  as
    

select  
		cast(trim(_c0) as date) as dt,
		trim(_c1) as symbol,
		cast(trim(_c2) as numeric(32,16)) as price_open,
		cast(trim(_c3) as numeric(32,16)) as price_high,
